# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Beads: durable state lives in the Dolt remote (refs/dolt/data on origin);
# the whole .beads/ working area stays local. issues.jsonl is no longer tracked
# (dropped 2026-09-22) — for human-readable backlog visibility we update the
# README/CHANGELOG at intervals instead.
.beads/*
